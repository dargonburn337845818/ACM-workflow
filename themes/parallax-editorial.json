  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#8A7F6B", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "punctuation.definition.string"],
      "settings": { "foreground": "#6F7D52" }
    },
    {
      "scope": ["constant.numeric", "constant.character", "constant.other"],
      "settings": { "foreground": "#A57A3D" }
    },
    {
      "scope": ["keyword", "storage", "storage.type"],
      "settings": { "foreground": "#B3401F", "fontStyle": "italic" }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#1A1712" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"],
      "settings": { "foreground": "#5B6B8C" }
    },
    {
      "scope": ["variable", "variable.parameter", "meta.definition.variable"],
      "settings": { "foreground": "#1A1712" }
    },
    {
      "scope": ["constant.language", "constant.other.language"],
      "settings": { "foreground": "#B3401F" }
    },
    {
      "scope": ["entity.other.attribute-name", "meta.attribute"],
      "settings": { "foreground": "#8A5E7E" }
    },
    {
      "scope": ["punctuation", "meta.brace"],
      "settings": { "foreground": "#6B6257" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#B23A2A", "fontStyle": "underline" }
    }
  ]
}
