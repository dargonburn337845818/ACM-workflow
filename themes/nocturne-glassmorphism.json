  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#7C9CC4", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "punctuation.definition.string"],
      "settings": { "foreground": "#A6B98E" }
    },
    {
      "scope": ["constant.numeric", "constant.character", "constant.other"],
      "settings": { "foreground": "#E4B863" }
    },
    {
      "scope": ["keyword", "storage", "storage.type"],
      "settings": { "foreground": "#E4B863", "fontStyle": "italic" }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#9BB6D8" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"],
      "settings": { "foreground": "#7C9CC4" }
    },
    {
      "scope": ["variable", "variable.parameter", "meta.definition.variable"],
      "settings": { "foreground": "#FFFFFF" }
    },
    {
      "scope": ["constant.language", "constant.other.language"],
      "settings": { "foreground": "#E4B863" }
    },
    {
      "scope": ["entity.other.attribute-name", "meta.attribute"],
      "settings": { "foreground": "#C98BB8" }
    },
    {
      "scope": ["punctuation", "meta.brace"],
      "settings": { "foreground": "#7C9CC4" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#C25644", "fontStyle": "underline" }
    }
  ]
}
