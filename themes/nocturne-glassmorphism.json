  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6B7280", "fontStyle": "italic" } },
    { "scope": ["string", "punctuation.definition.string"], "settings": { "foreground": "#A3D9B5" } },
    { "scope": ["constant.numeric", "constant.character", "constant.other"], "settings": { "foreground": "#E4B863" } },
    { "scope": ["keyword", "storage", "storage.type"], "settings": { "foreground": "#E4B863", "fontStyle": "italic" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#B8C2CC" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.class"], "settings": { "foreground": "#9AA3AE" } },
    { "scope": ["variable", "variable.parameter"], "settings": { "foreground": "#F5F6F8" } },
    { "scope": ["constant.language"], "settings": { "foreground": "#E4B863" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#C7A3C9" } },
    { "scope": ["punctuation", "meta.brace"], "settings": { "foreground": "#8A929C" } },
    { "scope": ["invalid"], "settings": { "foreground": "#F28B82", "fontStyle": "underline" } }
  ]
