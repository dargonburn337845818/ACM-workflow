/* Codeforces 难度阶梯 · 浅色现代圆润风 */

QMainWindow {
    background: #f3f4f8;
    color: #1c1f26;
}

QDialog {
    background: #ffffff;
    color: #1c1f26;
}

QWidget {
    background: transparent;
    color: #1c1f26;
    font-family: "Segoe UI", "Microsoft YaHei";
    font-size: 13px;
}

QWidget#appShell {
    background: #f3f4f8;
    border: none;
    border-radius: 0;
}

QWidget#appBody {
    background: transparent;
}

QFrame#titleBar {
    background: transparent;
    border-bottom: 1px solid #e2e5ec;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
}

QWidget#appShell[maximized="true"] {
    background: #f3f4f8;
    border: none;
    border-radius: 0;
}

QFrame#titleBar[maximized="true"] {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
}

QLabel#winTitle {
    font-size: 13px;
    font-weight: 600;
    color: #6d7482;
}

QPushButton#winClose, QPushButton#winMin, QPushButton#winMax {
    border: none;
    border-radius: 7px;
    padding: 0;
}

QPushButton#winClose {
    background: #ff5f57;
}

QPushButton#winClose:hover {
    background: #ff7b74;
}

QPushButton#winMin {
    background: #febc2e;
}

QPushButton#winMin:hover {
    background: #ffce5c;
}

QPushButton#winMax {
    background: #28c840;
}

QPushButton#winMax:hover {
    background: #4cdb62;
}

QFrame#sidebar {
    background: #ffffff;
    border-right: 1px solid #e2e5ec;
}

QFrame#rightContainer {
    background: #f3f4f8;
}

QLabel#appTitle {
    font-size: 20px;
    font-weight: 700;
    padding: 4px 8px;
    color: #1c1f26;
}

QLabel#globalProgress {
    background: #f4f5f9;
    border: 1px solid #e2e5ec;
    border-radius: 12px;
    padding: 10px 12px;
    color: #6d7482;
    font-size: 13px;
}

QLabel#animLabel {
    font-size: 12px;
    color: #6d7482;
    padding: 2px 8px;
}

QListWidget#tierList {
    background: transparent;
    border: none;
    outline: none;
    padding: 4px;
}

QListWidget#tierList::item {
    border-radius: 10px;
    padding: 8px 10px;
    margin: 2px 0;
    color: #1c1f26;
}

QListWidget#tierList::item:hover {
    background: #f4f5f9;
}

QListWidget#tierList::item:selected {
    background: rgba(59, 110, 245, 12%);
    border: 1px solid #3b6ef5;
    color: #1c1f26;
}

QPushButton {
    background: #f4f5f9;
    border: 1px solid #e2e5ec;
    border-radius: 10px;
    padding: 8px 14px;
    color: #1c1f26;
    font-size: 13px;
    font-weight: 500;
}

QPushButton:hover {
    background: #eceef4;
    border-color: #3b6ef5;
}

QPushButton:pressed {
    background: #ffffff;
}

QPushButton#styleBtn, QPushButton#resetBtn {
    margin-top: 4px;
}

QPushButton#resetBtn {
    color: #d65a5a;
}

QPushButton#resetBtn:hover {
    background: rgba(214, 90, 90, 10%);
    border-color: #d65a5a;
}

QComboBox {
    background: #f4f5f9;
    border: 1px solid #e2e5ec;
    border-radius: 10px;
    padding: 6px 12px;
    color: #1c1f26;
}

QComboBox:hover {
    border-color: #3b6ef5;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background: #ffffff;
    border: 1px solid #e2e5ec;
    border-radius: 10px;
    selection-background-color: rgba(59, 110, 245, 12%);
    selection-color: #1c1f26;
    outline: none;
    padding: 4px;
}

QProgressBar#tierProgress {
    background: #f4f5f9;
    border: 1px solid #e2e5ec;
    border-radius: 999px;
    height: 6px;
    text-align: center;
    color: #6d7482;
    font-size: 10px;
}

QProgressBar#tierProgress::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #3b6ef5, stop:1 #6c8cff);
    border-radius: 999px;
}

QPushButton#toolBtn {
    padding: 8px 12px;
    white-space: nowrap;
}

QPushButton#groupHeader {
    font-size: 14px;
    font-weight: 700;
    color: #2558e0;
    background: transparent;
    border: none;
    padding: 8px 4px 2px 4px;
    text-align: left;
}

QPushButton#groupHeader:hover {
    color: #3b6ef5;
    background: transparent;
    border: none;
}

QFrame#tagDetail {
    background: #fbfcff;
    border: 1px solid #e2e5ec;
    border-radius: 10px;
    margin-left: 28px;
}

QLabel#tagDetailText {
    font-size: 12px;
    color: #4a5160;
}

QScrollArea {
    background: transparent;
    border: none;
}

QFrame#tagRow {
    background: #ffffff;
    border: 1px solid #e2e5ec;
    border-radius: 12px;
    padding: 8px 10px;
}

QFrame#tagRow:hover {
    border-color: #3b6ef5;
    background: #fbfcff;
}

QFrame#tagRow[mastered="true"] {
    background: rgba(59, 110, 245, 6%);
    border-color: rgba(59, 110, 245, 30%);
}

QLabel#tagName {
    font-size: 15px;
    font-weight: 600;
    color: #1c1f26;
}

QLabel#tagDesc {
    font-size: 12px;
    color: #6d7482;
}

QLabel#cfTag {
    background: rgba(59, 110, 245, 10%);
    border: 1px solid rgba(59, 110, 245, 25%);
    border-radius: 999px;
    padding: 3px 10px;
    color: #2558e0;
    font-size: 11px;
}

QPushButton#detailBtn {
    background: #f4f5f9;
    border: 1px solid #e2e5ec;
    border-radius: 8px;
    padding: 6px 12px;
    color: #1c1f26;
    font-size: 12px;
}

QPushButton#detailBtn:hover {
    border-color: #3b6ef5;
    color: #2558e0;
}

QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 6px;
    border: 2px solid #e2e5ec;
    background: #f4f5f9;
}

QCheckBox::indicator:hover {
    border-color: #3b6ef5;
}

QCheckBox::indicator:checked {
    background: #3b6ef5;
    border-color: #3b6ef5;
}

QDialog {
    background: #ffffff;
    border-radius: 16px;
}

QLabel#pathLabel {
    font-size: 11px;
    color: #6d7482;
}

QLabel#algName {
    font-size: 20px;
    font-weight: 700;
    color: #1c1f26;
}

QLabel#introLabel {
    font-size: 13px;
    color: #6d7482;
}

QLabel#complexityLabel {
    font-size: 12px;
    color: #6d7482;
}

QLabel#qualityLabel {
    font-size: 11px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 999px;
}

QLabel#qualityLabel[quality="complete"] {
    color: #2f9e6e;
    background: rgba(47, 158, 110, 10%);
    border: 1px solid rgba(47, 158, 110, 30%);
}

QLabel#qualityLabel[quality="skeleton"] {
    color: #c77f2a;
    background: rgba(199, 127, 42, 10%);
    border: 1px solid rgba(199, 127, 42, 30%);
}

QLabel#qualityLabel[quality="todo"] {
    color: #d65a5a;
    background: rgba(214, 90, 90, 10%);
    border: 1px solid rgba(214, 90, 90, 30%);
}

QPushButton#copyBtn {
    background: #3b6ef5;
    border: 1px solid #3b6ef5;
    border-radius: 8px;
    padding: 6px 14px;
    color: white;
}

QPushButton#copyBtn:hover {
    background: #2558e0;
}

QPlainTextEdit#codeView {
    background: #f4f5f9;
    border: 1px solid #e2e5ec;
    border-radius: 12px;
    padding: 12px;
    color: #1c1f26;
    selection-background-color: #3b6ef5;
}

QTabWidget::pane {
    border: 1px solid #e2e5ec;
    border-radius: 12px;
    background: #ffffff;
    top: -1px;
}

QTabBar::tab {
    background: transparent;
    color: #6d7482;
    padding: 8px 14px;
    border: 1px solid transparent;
    border-radius: 10px 10px 0 0;
}

QTabBar::tab:selected {
    color: #2558e0;
    background: #f4f5f9;
    border-color: #e2e5ec;
    border-bottom-color: #f4f5f9;
    font-weight: 600;
}

QTabBar::tab:hover {
    color: #1c1f26;
}

QPushButton#closeBtn {
    background: #f4f5f9;
    border: 1px solid #e2e5ec;
    border-radius: 10px;
    padding: 8px 16px;
}

QPushButton#closeBtn:hover {
    border-color: #3b6ef5;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #d8dce5;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #3b6ef5;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #d8dce5;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #3b6ef5;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ===== 信息论视角 ===== */
QPushButton#infoBtn {
    margin-top: 6px;
    padding: 8px 6px;
    font-size: 13px;
    font-weight: 600;
    color: #2558e0;
}

QLabel#phaseLabel {
    font-size: 13px;
    font-weight: 600;
    color: #4a5160;
    padding: 2px 4px;
}

QLabel#infoBadge {
    background: rgba(59, 110, 245, 8%);
    border: 1px solid rgba(59, 110, 245, 25%);
    border-radius: 999px;
    padding: 2px 8px;
    font-size: 10px;
    color: #2558e0;
}

QLabel#infoBadge[op="传播松弛"] {
    background: rgba(30, 160, 135, 8%);
    border-color: rgba(30, 160, 135, 30%);
    color: #1e9f87;
}

QLabel#infoBadge[op="剪枝决策"] {
    background: rgba(200, 130, 40, 8%);
    border-color: rgba(200, 130, 40, 30%);
    color: #b06f1f;
}

QLabel#infoBadge[op="变换域映射"] {
    background: rgba(150, 70, 180, 8%);
    border-color: rgba(150, 70, 180, 30%);
    color: #9646b4;
}

QLabel#infoBadge[op="基线/暴力"] {
    background: rgba(109, 116, 130, 8%);
    border-color: rgba(109, 116, 130, 25%);
    color: #6d7482;
}

QLabel#infoBadgeTopo, QLabel#infoBadgeDyn {
    background: transparent;
    border: 1px dashed #d8dce5;
    border-radius: 999px;
    padding: 2px 8px;
    font-size: 10px;
    color: #6d7482;
}

QPushButton#infoFilterBtn {
    padding: 5px 10px;
    font-size: 11px;
    border-radius: 8px;
}

QPushButton#infoFilterBtn:checked {
    background: rgba(59, 110, 245, 12%);
    border-color: #3b6ef5;
    color: #1c1f26;
}

QLabel#infoText {
    font-size: 12px;
    color: #2558e0;
}

QLabel#infoWhy {
    font-size: 12px;
    color: #4a5160;
}

QTextBrowser#guideBrowser {
    background: #ffffff;
    border: 1px solid #e2e5ec;
    border-radius: 12px;
    padding: 8px;
    color: #1c1f26;
}
