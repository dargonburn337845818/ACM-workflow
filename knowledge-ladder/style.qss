/* DeskBox 深色亚克力（桌面端近似） */
* {
    font-family: "Segoe UI Variable", "Segoe UI", "PingFang SC", sans-serif;
    color: #F5F6F8;
}

QMainWindow {
    background: #131519;
}

/* 默认亚克力：外壳用暗色渐变做底层，内容层保持透明，面板用半透明材质 */
QWidget#appShell {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #1D2026, stop:0.5 #15171C, stop:1 #0F1115);
}

QWidget#appBody, QWidget#rightContainer {
    background: transparent;
}

QFrame#titleBar {
    background: rgba(18,20,24,0.82);
    border-bottom: 1px solid rgba(255,255,255,0.06);
}

QWidget#sidebar {
    background: rgba(18,20,24,0.72);
    border-right: 1px solid rgba(255,255,255,0.06);
}

QPushButton {
    background: rgba(30,33,38,0.75);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 8px;
    color: rgba(255,255,255,0.85);
    padding: 8px 14px;
    font-size: 14px;
}

QPushButton:hover {
    background: rgba(45,48,54,0.85);
    border-color: rgba(255,255,255,0.14);
    color: #FFFFFF;
}

QPushButton#dissectNext,
QPushButton#dissectRestart,
QPushButton#next {
    background: rgba(228,184,99,0.12);
    border: 1px solid rgba(228,184,99,0.35);
    color: #F3DCA8;
}

QPushButton#dissectBtn, QPushButton#infoBtn, QPushButton#templateBtn, QPushButton#wallpaperBtn {
    background: rgba(30,33,38,0.7);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 8px;
    color: rgba(255,255,255,0.9);
    margin-top: 6px;
}

QListWidget#tierList { background: transparent; border: none; outline: none; }
QListWidget#tierList::item {
    background: rgba(30,33,38,0.6);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 8px;
    padding: 10px 8px;
    margin: 4px 2px;
    color: rgba(255,255,255,0.8);
}
QListWidget#tierList::item:selected {
    background: rgba(228,184,99,0.12);
    border-color: rgba(228,184,99,0.4);
    color: #F3DCA8;
}

QProgressBar#tierProgress { background: rgba(255,255,255,0.08); border: none; border-radius: 4px; height: 6px; }
QProgressBar#tierProgress::chunk { background: #E4B863; border-radius: 4px; }

QLabel#tagName { font-weight: 600; font-size: 16px; color: rgba(255,255,255,0.95); }
QLabel#tagDesc, QLabel#phaseLabel { color: rgba(255,255,255,0.5); font-size: 12px; }

QFrame#tagRow {
    background: rgba(30,33,38,0.55);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 10px;
    margin: 4px 0;
}

QLabel#infoBadge, QLabel#infoBadgeTopo, QLabel#infoBadgeDyn {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 6px;
    color: rgba(255,255,255,0.8);
    font-size: 10px;
    padding: 3px 8px;
}

QDialog { background: #131519; }
QPlainTextEdit#codeView {
    background: rgba(15,16,19,0.9);
    color: #F5F6F8;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 8px;
    font-family: "Consolas", monospace;
}
QTextBrowser#guideBrowser {
    background: rgba(15,16,19,0.9);
    color: #F5F6F8;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 10px;
}

QCheckBox::indicator {
    width: 16px; height: 16px;
    border: 1px solid rgba(255,255,255,0.25);
    border-radius: 4px;
    background: rgba(255,255,255,0.06);
}
QCheckBox::indicator:checked { background: #E4B863; border-color: #E4B863; }

QLabel#dissectTitle { font-size: 30px; color: rgba(255,255,255,0.96); }
QLabel#dissectHint { color: rgba(255,255,255,0.5); font-style: italic; font-size: 14px; }
QLabel#dissectStep { color: #E4B863; font-size: 14px; letter-spacing: 2px; }

QPushButton#dissectOption {
    background: rgba(30,33,38,0.65);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 10px;
    color: rgba(255,255,255,0.9);
    text-align: left;
    font-size: 16px;
    padding: 14px 18px;
    margin: 4px 0;
}
QPushButton#dissectOption:hover {
    background: rgba(45,48,54,0.8);
    border-color: rgba(255,255,255,0.14);
}

QLabel#dissectResultTitle, QLabel#dissectThinkingTitle { font-size: 26px; color: rgba(255,255,255,0.95); }
QLabel#dissectNode, QLabel#dissectThinkCard {
    background: rgba(30,33,38,0.6);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 10px;
    padding: 12px 16px;
    margin: 4px 0;
    color: rgba(255,255,255,0.85);
}
QLabel#dissectFinal {
    background: rgba(228,184,99,0.08);
    border: 1px solid rgba(228,184,99,0.3);
    border-radius: 10px;
    padding: 12px 16px;
    color: #F3DCA8;
}
QLabel#miniNote { color: rgba(255,255,255,0.5); font-size: 12px; font-style: italic; }

QFrame#dissectAcrylic {
    background: rgba(18,20,24,0.78);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 12px;
}

QWidget#dissectContent {
    background: transparent;
}

QScrollArea {
    background: transparent;
    border: none;
}

/* ===== 全局深色控制：防止默认白底 / 白字 ===== */
QWidget {
    background: transparent;
}
QLabel {
    background: transparent;
}

QDialog, QMessageBox, QInputDialog, QFileDialog {
    background: rgba(18,20,24,0.96);
    color: #F5F6F8;
}

QMenu {
    background: rgba(24,26,31,0.96);
    color: #F5F6F8;
    border: 1px solid rgba(255,255,255,0.10);
}
QMenu::item:selected {
    background: rgba(228,184,99,0.18);
    color: #F3DCA8;
}

QToolTip {
    background: rgba(24,26,31,0.96);
    color: #F5F6F8;
    border: 1px solid rgba(255,255,255,0.10);
}

QAbstractItemView {
    background: rgba(20,22,27,0.90);
    color: #F5F6F8;
    border: 1px solid rgba(255,255,255,0.08);
    selection-background-color: rgba(228,184,99,0.18);
    selection-color: #F3DCA8;
}

QListView, QListWidget {
    background: transparent;
    color: #F5F6F8;
    outline: none;
}

QComboBox {
    background: rgba(30,33,38,0.80);
    color: #F5F6F8;
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: 6px;
    padding: 5px 10px;
}
QComboBox QAbstractItemView {
    background: rgba(24,26,31,0.96);
    color: #F5F6F8;
    border: 1px solid rgba(255,255,255,0.10);
    selection-background-color: rgba(228,184,99,0.18);
    selection-color: #F3DCA8;
}
QComboBox::drop-down {
    border: none;
    width: 18px;
}
QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid rgba(255,255,255,0.75);
}

QLineEdit {
    background: rgba(20,22,27,0.85);
    color: #F5F6F8;
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: 6px;
    padding: 5px 8px;
    selection-background-color: rgba(228,184,99,0.25);
}

QTextBrowser, QTextEdit, QPlainTextEdit {
    background: rgba(20,22,27,0.85);
    color: #F5F6F8;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 6px;
    selection-background-color: rgba(228,184,99,0.25);
}

QScrollArea, QAbstractScrollArea, QScrollArea > QWidget > QWidget {
    background: transparent;
    border: none;
}

QTabWidget::pane {
    background: rgba(20,22,27,0.75);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 6px;
}
QTabBar::tab {
    background: rgba(30,33,38,0.65);
    color: rgba(255,255,255,0.72);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 6px;
    padding: 6px 12px;
    margin-right: 4px;
}
QTabBar::tab:selected {
    background: rgba(228,184,99,0.14);
    color: #F3DCA8;
    border-color: rgba(228,184,99,0.35);
}

QCheckBox {
    background: transparent;
    color: #F5F6F8;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: rgba(255,255,255,0.16);
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(255,255,255,0.28);
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: rgba(255,255,255,0.16);
    border-radius: 4px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover {
    background: rgba(255,255,255,0.28);
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

QLabel#dissectArrow {
    color: rgba(255,255,255,0.40);
    font-size: 18px;
}

/* 移动端 diagram 的桌面版 */
QFrame#diagramNode {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 10px;
}
QLabel#diagramNodeLabel {
    color: #E4B863;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
}
QLabel#diagramNodeValue {
    color: rgba(255,255,255,0.95);
    font-family: Georgia, "Songti SC", serif;
    font-size: 18px;
    font-weight: 600;
}
QPushButton#opPill {
    background: rgba(228,184,99,0.15);
    border: 1px solid rgba(228,184,99,0.40);
    border-radius: 12px;
    color: #F3DCA8;
    font-size: 13px;
    font-weight: 600;
    padding: 6px 12px;
}
QPushButton#opPill:hover {
    background: rgba(228,184,99,0.25);
    border-color: rgba(228,184,99,0.55);
}
QLabel#goHint {
    color: #E4B863;
    font-size: 12px;
}
QPushButton#diagramNodeButton {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 10px;
    color: #F5F6F8;
    text-align: left;
    padding: 12px 14px;
}
QPushButton#diagramNodeButton:hover {
    background: rgba(255,255,255,0.10);
}

QTextBrowser#flowBrowser {
    background: rgba(20,22,27,0.65);
    border: none;
    color: #F5F6F8;
}

QScrollArea#dissectScroll {
    background: transparent;
    border: none;
}

QLabel#opsDetail {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(228,184,99,0.25);
    border-radius: 8px;
    color: rgba(255,255,255,0.85);
    padding: 10px 12px;
}
